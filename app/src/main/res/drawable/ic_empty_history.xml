<?xml version="1.0" encoding="utf-8"?>
<!--
    DESIGN §8.3: a folded receipt with a wax seal, and a closed ledger, on paper —
    lots of negative space, no checklist, no people. Unlike the pictograms this one
    is allowed baked color ("cream already in the scene"), so it carries the palette
    directly rather than being tinted at runtime.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="220dp"
    android:height="130dp"
    android:viewportWidth="220"
    android:viewportHeight="130">
    <!-- receipt -->
    <path
        android:pathData="M40,30 L74,30 L74,96 L64,108 L54,96 L44,108 L40,96 Z"
        android:fillColor="#F6F1E8"
        android:strokeColor="#2A241F"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M48,44 L66,44 M48,54 L66,54 M48,64 L60,64"
        android:strokeColor="#2A241F"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M49,78 A8,8 0 1,0 65,78 A8,8 0 1,0 49,78 Z"
        android:fillColor="#9A4A32"
        android:strokeColor="#7A3A26"
        android:strokeWidth="1" />
    <!-- ledger -->
    <path
        android:pathData="M120,60 L196,48 L204,54 L204,88 L128,100 L120,94 Z"
        android:fillColor="#EFE7D8"
        android:strokeColor="#2A241F"
        android:strokeWidth="2"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M120,60 L128,66 L128,100 M128,66 L204,54"
        android:strokeColor="#2A241F"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
